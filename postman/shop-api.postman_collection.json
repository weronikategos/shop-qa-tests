{
  "info": {
    "name": "Flask SQL Shop API",
    "description": "REST API tests for the flask-sql-shop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));",
              "pm.test(\"Response under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "List categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const categories = pm.response.json();",
              "pm.test(\"There are categories\", () => pm.expect(categories.length).to.be.above(0));",
              "pm.collectionVariables.set(\"categoryId\", categories[0].category_id);",
              "pm.collectionVariables.set(\"categoryName\", categories[0].name);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        }
      }
    },
    {
      "name": "List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const products = pm.response.json();",
              "pm.test(\"Every product has the required fields\", () => products.forEach(p => pm.expect(p).to.include.keys(\"product_id\", \"name\", \"price\", \"stock\", \"category\")));",
              "pm.test(\"Prices positive, stock not negative\", () => products.forEach(p => { pm.expect(p.price).to.be.above(0); pm.expect(p.stock).to.be.at.least(0); }));",
              "pm.collectionVariables.set(\"productId\", products[0].product_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "Products in a category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only the selected category\", () => pm.response.json().forEach(p => pm.expect(p.category).to.eql(pm.collectionVariables.get(\"categoryName\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category={{categoryId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "category",
              "value": "{{categoryId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Invalid category",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"There is an error message\", () => pm.expect(pm.response.json()).to.have.property(\"error\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "category",
              "value": "abc"
            }
          ]
        }
      }
    },
    {
      "name": "Single product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"It is the same product\", () => pm.expect(pm.response.json().product_id).to.eql(Number(pm.collectionVariables.get(\"productId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "Product that doesn't exist",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Response is JSON\", () => pm.response.to.be.json);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products",
            "999999"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "categoryId",
      "value": ""
    },
    {
      "key": "categoryName",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ]
}
